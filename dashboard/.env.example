# Company Firebase web app config (Marc Innotech — NOT a personal project).
# Copy this file to .env and fill in the values from the company's Firebase
# project (Project settings -> Your apps -> Web app). Never commit .env.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Patient API (optional). When set, the dashboard loads the patient list
# from the API and saves new patients to it; when unset or unreachable,
# it falls back to the in-browser demo data. See
# workspace/marc-innotech/patient-api/README.md. Local API dev server:
#   VITE_API_URL=http://localhost:3001
# Live API (once deployed behind TLS):
#   VITE_API_URL=https://api.marcinnotech.net
VITE_API_URL=
