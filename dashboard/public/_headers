# CareTask cache policy (deploy-35, Jake's stale-cache fix).
# The HTML shell and version.json must NEVER be cached: the shell
# points at the current hashed bundle, and version.json is how a
# running tab detects that it is stale. Hashed assets under
# /assets/ are safe to cache forever — their names change when
# their content does.
/index.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
/version.json
  Cache-Control: no-store
/assets/*
  Cache-Control: public, max-age=31536000, immutable
