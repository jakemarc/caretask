# CareTask patient API — environment template
# Copy this file to .env and fill in the values. Never commit .env.
# No real secret belongs in this file; these are placeholders only.

# Server port (the API binds 127.0.0.1 only, on purpose).
PORT=3001

# Postgres connection (the VM's local Postgres; the API never reaches a
# remote database). PGPASSWORD is the caretask_app role's password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=caretask_demo
PGUSER=caretask_app
PGPASSWORD=

# Firebase token verification. The service-account JSON lives on the VM
# only and must belong to the MARC INNOTECH Firebase project (the same
# project the dashboard signs into).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/caretask-service-account.json

# Allowlist, comma-separated. FAILS CLOSED: if unset or empty, every
# /patients request is rejected with 403.
ALLOWED_EMAILS=

# CORS: the dashboard origin(s) allowed to call this API, comma-separated.
# Local dashboard dev server:
#   DASHBOARD_ORIGIN=http://localhost:5173
# Live dashboard (when deployed, via Caddy/TLS in front of this API):
#   DASHBOARD_ORIGIN=https://marcinnotech-app.pages.dev
# If unset, CORS is off and dashboard browser calls are blocked.
DASHBOARD_ORIGIN=
